# Environment variables for TerraGuard
# Copy this file to .env and replace placeholders with your actual values.

# -------------------------------------------------------------
# 1. Google Earth Engine Service Account Authentication (Backend)
# -------------------------------------------------------------
# Path to your Google Cloud service account JSON key file with Earth Engine API enabled.
EE_SERVICE_ACCOUNT_JSON=/path/to/your-service-account.json

# (Optional) Google Cloud Project ID for Earth Engine billing & quota
GCP_PROJECT_ID=your-gcp-project-id

# -------------------------------------------------------------
# 2. Free AI Online Agent Providers (Deforestation Forecasting)
# -------------------------------------------------------------
# Best Free Online Option 1: Hugging Face Serverless Inference API (Free forever)
# Get a free read token at: https://huggingface.co/settings/tokens
# Models supported out-of-the-box: meta-llama/Llama-3.2-3B-Instruct, Qwen/Qwen2.5-7B-Instruct
VITE_HUGGINGFACE_API_KEY=hf_your_free_huggingface_token_here

# Best Free Online Option 2: Google Gemini Flash 1.5 API (Free tier: 15 RPM / 1M TPM)
# Get a free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_free_gemini_api_key_here

# -------------------------------------------------------------
# 3. Server Configuration
# -------------------------------------------------------------
# Frontend API base URL (used by Vite proxy to reach FastAPI backend)
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# -------------------------------------------------------------
# 4. Live monitoring (backend)
# -------------------------------------------------------------
# Minutes between automatic re-scans of watched regions (0 = off)
MONITOR_INTERVAL_MIN=60
# Largest area one live scan may cover (km2)
MAX_AREA_KM2=1500
# Browser origins allowed to call the backend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Hansen label version used by heldout_validation.py
HANSEN_ASSET=UMD/hansen/global_forest_change_2023_v1_11
